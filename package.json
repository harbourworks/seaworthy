{
  "name": "seaworthy-cli",
  "version": "0.2.1",
  "description": "Pre-launch security check for AI-built apps: leaked keys, open database rules, unprotected API routes, unsafe LLM code. Runs locally; your code never leaves your machine.",
  "keywords": [
    "security",
    "scanner",
    "sast",
    "supabase",
    "firebase",
    "nextjs",
    "stripe",
    "llm",
    "mcp",
    "ai",
    "vibe-coding",
    "cli"
  ],
  "homepage": "https://dynamomaritime.com/seaworthy",
  "bugs": {
    "url": "https://dynamomaritime.com/support",
    "email": "support@dynamomaritime.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harbourworks/seaworthy.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Dynamo Maritime Ltd",
  "type": "module",
  "bin": {
    "seaworthy": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE-COMMERCIAL.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "self-scan": "node dist/cli.js scan ."
  },
  "dependencies": {
    "@babel/parser": "7.26.3",
    "ignore": "6.0.2",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@babel/types": "7.26.3",
    "@types/node": "20.17.10",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
