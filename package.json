{
  "name": "seaworthy-cli",
  "version": "0.6.0",
  "mcpName": "io.github.harbourworks/seaworthy",
  "description": "Pre-launch security check for AI-built apps: leaked keys, open Supabase rules, unprotected routes, unsafe LLM code. Runs locally.",
  "keywords": [
    "security",
    "security-scanner",
    "scanner",
    "sast",
    "pre-launch",
    "secrets",
    "secret-scanning",
    "supabase",
    "rls",
    "firebase",
    "nextjs",
    "stripe",
    "stripe-webhook",
    "sql-injection",
    "prompt-injection",
    "llm",
    "mcp",
    "mcp-server",
    "ai",
    "ai-generated-code",
    "vibe-coding",
    "cursor",
    "claude-code",
    "lovable",
    "bolt",
    "cli"
  ],
  "homepage": "https://dynamomaritime.com/seaworthy",
  "bugs": {
    "url": "https://dynamomaritime.com/support",
    "email": "support@dynamomaritime.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harbourworks/seaworthy.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Dynamo Maritime Ltd",
  "type": "module",
  "bin": {
    "seaworthy": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE-COMMERCIAL.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && tsx scripts/notices.mts",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "self-scan": "node dist/cli.js scan .",
    "docs:rules": "tsx scripts/docs.mts"
  },
  "dependencies": {
    "@babel/parser": "7.29.13",
    "ignore": "6.0.2",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@babel/types": "7.29.11",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "20.19.43",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "2.1.9",
    "zod": "4.6.7"
  }
}
